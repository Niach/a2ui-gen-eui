{
  "description": "Motion sugar: enter=, exit=, stagger=, delay= on any component (style.animation, exitAnimation, animationStagger, animationDelay); Motion(ref=\"name\") from the catalog's motions registry; Motion(kf=\"…\") keyframes into the eui-motion dialect.",
  "catalog": "catalog.json",
  "cases": [
    {
      "name": "motion_enter_exit_stagger_delay",
      "action": "compile",
      "input": "root = Column([a, b], stagger=60, s=\"col g8\")\na = Text(\"1\", enter=\"slide-in-up\", delay=120)\nb = Text(\"2\", enter=\"fade-in\", exit=\"fade-out\")",
      "expect": [
        {
          "version": "1.0",
          "createSurface": {
            "surfaceId": "main",
            "catalogId": "express/extensions",
            "components": [
              {
                "id": "root",
                "component": "Column",
                "children": [
                  "a",
                  "b"
                ],
                "style": {
                  "flexDirection": "column",
                  "gap": 8,
                  "animationStagger": 60
                }
              },
              {
                "id": "a",
                "component": "Text",
                "text": "1",
                "style": {
                  "animation": "slide-in-up",
                  "animationDelay": 120
                }
              },
              {
                "id": "b",
                "component": "Text",
                "text": "2",
                "style": {
                  "animation": "fade-in",
                  "exitAnimation": "fade-out"
                }
              }
            ]
          }
        }
      ],
      "decompiled": "surface(\"main\")\nroot = Column([a, b], s=\"col g8\", stagger=60)\na = Text(\"1\", enter=\"slide-in-up\", delay=120)\nb = Text(\"2\", enter=\"fade-in\", exit=\"fade-out\")"
    },
